<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="wreckscope-ref.exe"
        Arguments=""
        InstallLocation="C:\Program Files\WreckScope\WreckScope">
    </Installer>
    <PackageInformation
        PackageName="WreckScope"
        PackageDisplayName="WreckScope"
        PublisherName="CN=WreckScope"
        PublisherDisplayName="WreckScope"
        Version="0.1.0.0"
        PackageDescription="A wreckscope-ref application">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.wreckscope.app"
                Description="A wreckscope-ref application"
                DisplayName="WreckScope"
                ExecutableName="wreckscope-ref.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>WreckScope</DisplayName>
            <PublisherDisplayName>WreckScope</PublisherDisplayName>
            <Description>A wreckscope-ref application</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="wreckscope-ref.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
